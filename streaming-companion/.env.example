# Copy this file to .env and fill in your keys. Never commit the real .env file.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only required if chat.youtube.enabled is true in settings.yaml.
# Get one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
